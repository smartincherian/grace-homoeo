rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function authEmail() { return request.auth.token.get('email', '').lower(); }
    // Every account (Google or password) must have a verified email.
    function verified() { return request.auth.token.get('email_verified', false) == true; }
    // Keep in sync with SUPERADMIN_EMAIL in src/lib/access.ts.
    function SUPER() { return 'smartin.cherian@gmail.com'; }
    function superadmin() {
      return signedIn() && verified() && authEmail() == SUPER();
    }
    function allowed() {
      return signedIn() && verified() && (
        superadmin()
        || (exists(/databases/$(database)/documents/allowedEmails/$(authEmail()))
            && entryActive())
      );
    }
    // A user the superadmin made inactive keeps their entry and seat but has no access.
    function entryActive() {
      return get(/databases/$(database)/documents/allowedEmails/$(authEmail())).data.get('active', true) == true;
    }
    // The caller's clinic, from their allow-list entry ('' when unassigned).
    function myClinic() {
      return get(/databases/$(database)/documents/allowedEmails/$(authEmail())).data.get('clinicId', '');
    }
    function clinicData(c) { return get(/databases/$(database)/documents/clinics/$(c)).data; }
    // An inactive clinic blocks all its members (the owner too); the superadmin keeps access.
    function clinicActive(c) { return clinicData(c).get('active', true) == true; }
    function member(clinicId) {
      return superadmin() || (allowed() && myClinic() == clinicId && clinicActive(clinicId));
    }
    // Trial OK: authorized, a legacy clinic without trialEndsAt, or still inside the trial.
    function trialOk(c) {
      return clinicData(c).get('authorized', false) == true
        || !('trialEndsAt' in clinicData(c))
        || request.time.toMillis() < clinicData(c).trialEndsAt;
    }
    // A clinic whose trial ended is read-only; the superadmin is exempt.
    function canWrite(c) { return superadmin() || trialOk(c); }
    // Keep in sync with RESERVED_SLUGS in src/lib/clinic.ts.
    function reservedSlugs() {
      return ['login', 'admin', 'access', 'patients', 'inventory', 'calculator', 'funds', 'clinics',
              'people', 'settings', 'staff', 'bookings', 'verify-email', 'setup', 'signup'];
    }

    // Mirrors CLINIC_TYPES in src/lib/clinicType.ts; a missing type means homoeo.
    function clinicTypes() {
      return ['homoeo', 'general'];
    }
    // After this write, clinic c exists as a self-signup owned by e (and did not exist before).
    function selfSignupClinic(c, e) {
      return !exists(/databases/$(database)/documents/clinics/$(c))
        && getAfter(/databases/$(database)/documents/clinics/$(c)).data.ownerEmail == e
        && getAfter(/databases/$(database)/documents/clinics/$(c)).data.get('selfSignup', false) == true;
    }
    function owner(c) { return member(c) && clinicData(c).get('ownerEmail', '') == authEmail(); }
    // Who may add/remove a clinic's users: the superadmin or that clinic's owner.
    function manager(c) { return superadmin() || owner(c); }
    // After this write, seat s of clinic c holds email e.
    function seatAfterIs(c, s, e) {
      return existsAfter(/databases/$(database)/documents/clinics/$(c)/seats/$(s))
        && getAfter(/databases/$(database)/documents/clinics/$(c)/seats/$(s)).data.email == e;
    }
    // After this write, e's allow-list entry points at clinic c, seat s.
    function entryAfterIs(e, c, s) {
      return existsAfter(/databases/$(database)/documents/allowedEmails/$(e))
        && getAfter(/databases/$(database)/documents/allowedEmails/$(e)).data.clinicId == c
        && getAfter(/databases/$(database)/documents/allowedEmails/$(e)).data.seat == s;
    }
    // The only subcollections members may use under clinics/{clinicId}.
    function memberSubs() {
      return ['patients', 'consultations', 'generals', 'lsmc', 'inventory', 'orderItems', 'expenses', 'counters'];
    }

    function shortStr(v) { return v is string && v.size() <= 120; }
    function validContact(c) {
      return c is map
        && c.keys().hasOnly(['doctorName', 'qualifications', 'registrationNo', 'address', 'phone', 'email'])
        && c.keys().hasAll(['doctorName', 'qualifications', 'registrationNo', 'address', 'phone', 'email'])
        && shortStr(c.doctorName) && shortStr(c.qualifications) && shortStr(c.registrationNo)
        && shortStr(c.address) && shortStr(c.phone) && shortStr(c.email);
    }
    function validBranding(d) {
      return d.keys().hasOnly(['displayName', 'logoDataUrl', 'primaryColor', 'showScripture', 'contact', 'updatedAt', 'updatedBy'])
        && d.keys().hasAll(['displayName', 'logoDataUrl', 'primaryColor', 'showScripture', 'contact', 'updatedAt', 'updatedBy'])
        && d.displayName is string && d.displayName.size() <= 60
        && d.logoDataUrl is string && d.logoDataUrl.size() <= 200000
        && (d.logoDataUrl == '' || d.logoDataUrl.matches('^data:image/(png|webp|jpeg);base64,.*'))
        && d.primaryColor is string && d.primaryColor.matches('^#[0-9a-fA-F]{6}$')
        && d.showScripture is bool
        && validContact(d.contact)
        && d.updatedAt is number
        && d.updatedBy == authEmail();
    }

    // Clinic hours: weekly sessions per weekday (max 3), holidays, slot length.
    function validSchedule(d) {
      return d.keys().hasOnly(['slotMinutes', 'weekly', 'holidays', 'updatedAt', 'updatedBy'])
        && d.keys().hasAll(['slotMinutes', 'weekly', 'holidays', 'updatedAt', 'updatedBy'])
        && d.slotMinutes is int && d.slotMinutes >= 5 && d.slotMinutes <= 120
        && d.weekly is map
        && d.weekly.keys().hasOnly(['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'])
        && d.weekly.get('mon', []).size() <= 3 && d.weekly.get('tue', []).size() <= 3
        && d.weekly.get('wed', []).size() <= 3 && d.weekly.get('thu', []).size() <= 3
        && d.weekly.get('fri', []).size() <= 3 && d.weekly.get('sat', []).size() <= 3
        && d.weekly.get('sun', []).size() <= 3
        && d.holidays is list && d.holidays.size() <= 100
        && d.updatedAt is number
        && d.updatedBy == authEmail();
    }
    // Field types shared by appointments and their history copies.
    function apptFieldsOk(d) {
      return d.start is int && d.end is int && d.date is int
        && d.end > d.start && d.date <= d.start
        && d.patientName is string && d.patientName.size() >= 1 && d.patientName.size() <= 80
        && d.phone is string && d.phone.size() <= 20
        && d.note is string && d.note.size() <= 200
        && d.status is string
        && (d.patientId == null || d.patientId is string)
        && (d.consultationId == null || d.consultationId is string)
        && (d.serialNo == null || d.serialNo is int)
        && d.createdBy is string && d.createdAt is int;
    }
    function validAppt(d) {
      return d.keys().hasOnly(['date', 'start', 'end', 'patientId', 'patientName', 'phone', 'serialNo', 'status', 'note', 'createdBy', 'createdAt', 'consultationId'])
        && d.keys().hasAll(['date', 'start', 'end', 'patientId', 'patientName', 'phone', 'serialNo', 'status', 'note', 'createdBy', 'createdAt', 'consultationId'])
        && apptFieldsOk(d)
        && d.status in ['booked', 'arrived', 'done'];
    }
    // History copy: the 12 appointment fields plus closedAt and closedBy.
    function validClosed(d) {
      return d.keys().hasOnly(['date', 'start', 'end', 'patientId', 'patientName', 'phone', 'serialNo', 'status', 'note', 'createdBy', 'createdAt', 'consultationId', 'closedAt', 'closedBy'])
        && d.keys().hasAll(['date', 'start', 'end', 'patientId', 'patientName', 'phone', 'serialNo', 'status', 'note', 'createdBy', 'createdAt', 'consultationId', 'closedAt', 'closedBy'])
        && apptFieldsOk(d)
        && d.status in ['cancelled', 'no-show']
        && d.closedAt is int
        && d.closedBy == authEmail();
    }

    // The allow list: anyone may check their own entry. A user is added or
    // removed together with their seat doc in one batch (max 3 seats per clinic);
    // entries are never updated in place, so nobody can move between clinics.
    match /allowedEmails/{email} {
      allow get: if signedIn() && verified() && email == authEmail();
      allow list: if superadmin();
      allow create: if manager(request.resource.data.clinicId)
        && canWrite(request.resource.data.clinicId)
        && email != SUPER()
        && request.resource.data.keys().hasOnly(['email', 'clinicId', 'seat', 'addedAt', 'addedBy'])
        && request.resource.data.email == email
        && request.resource.data.seat in ['1', '2', '3']
        && seatAfterIs(request.resource.data.clinicId, request.resource.data.seat, email);
      // Self-signup: a new user's own seat-1 entry in the clinic they are creating.
      allow create: if signedIn() && verified() && !superadmin()
        && email == authEmail()
        && request.resource.data.keys().hasOnly(['email', 'clinicId', 'seat', 'addedAt', 'addedBy'])
        && request.resource.data.email == email
        && request.resource.data.seat == '1'
        && request.resource.data.addedBy == authEmail()
        && selfSignupClinic(request.resource.data.clinicId, email)
        && seatAfterIs(request.resource.data.clinicId, '1', email);
      // Only the superadmin turns a user's access off or on.
      allow update: if superadmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
        && request.resource.data.active is bool;
      allow delete: if superadmin();
      allow delete: if manager(resource.data.clinicId)
        && canWrite(resource.data.clinicId)
        && !seatAfterIs(resource.data.clinicId, resource.data.get('seat', '0'), email);
    }

    // Each clinic's data lives under clinics/{clinicId}; members see only their own.
    match /clinics/{clinicId} {
      // Its own users may read the clinic doc even when inactive, to see why.
      allow get: if superadmin()
        || (signedIn() && verified()
            && exists(/databases/$(database)/documents/allowedEmails/$(authEmail()))
            && myClinic() == clinicId)
        // Signup checks a slug is free: anyone verified may read a missing clinic.
        || (signedIn() && verified() && resource == null);
      allow list: if superadmin();
      // ownerEmail, when set, must name a user allow-listed into this clinic.
      allow create, update: if superadmin()
        && (!('active' in request.resource.data) || request.resource.data.active is bool)
        && (!('trialEndsAt' in request.resource.data) || request.resource.data.trialEndsAt is int)
        && (!('authorized' in request.resource.data) || request.resource.data.authorized is bool)
        && (!('type' in request.resource.data) || request.resource.data.type in clinicTypes())
        && (!('ownerEmail' in request.resource.data)
            || entryAfterIs(request.resource.data.ownerEmail, clinicId,
                 getAfter(/databases/$(database)/documents/allowedEmails/$(request.resource.data.ownerEmail)).data.seat));
      // Self-signup: a verified user with no allow-list entry creates their own
      // clinic on a 21-day trial, with seat 1 and their entry in the same batch.
      allow create: if signedIn() && verified() && !superadmin()
        && !exists(/databases/$(database)/documents/allowedEmails/$(authEmail()))
        && clinicId.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && clinicId.size() >= 3 && clinicId.size() <= 40
        && !(clinicId in reservedSlugs())
        && request.resource.data.keys().hasOnly(['name', 'type', 'createdAt', 'ownerEmail', 'timeZone', 'trialEndsAt', 'authorized', 'authorizedAt', 'selfSignup'])
        && request.resource.data.keys().hasAll(['name', 'type', 'createdAt', 'ownerEmail', 'timeZone', 'trialEndsAt', 'authorized', 'authorizedAt', 'selfSignup'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 60
        && request.resource.data.ownerEmail == authEmail()
        && request.resource.data.authorized == false
        && request.resource.data.authorizedAt == null
        && request.resource.data.selfSignup == true
        && request.resource.data.type in clinicTypes()
        && request.resource.data.timeZone == 'Asia/Kolkata'
        && request.resource.data.createdAt is int
        && request.resource.data.createdAt <= request.time.toMillis() + 600000
        && request.resource.data.createdAt >= request.time.toMillis() - 600000
        && request.resource.data.trialEndsAt == request.resource.data.createdAt + 1814400000
        && entryAfterIs(authEmail(), clinicId, '1')
        && seatAfterIs(clinicId, '1', authEmail());
      allow delete: if superadmin();

      // Seats 1-3 cap a clinic at three users; each seat pairs with an allow-list entry.
      match /seats/{seatId} {
        allow read: if member(clinicId);
        allow create: if manager(clinicId)
          && canWrite(clinicId)
          && seatId in ['1', '2', '3']
          && request.resource.data.keys().hasOnly(['email'])
          && request.resource.data.email != SUPER()
          && entryAfterIs(request.resource.data.email, clinicId, seatId);
        // Self-signup: the new owner's seat 1, written with the clinic doc.
        allow create: if signedIn() && verified() && !superadmin()
          && seatId == '1'
          && request.resource.data.keys().hasOnly(['email'])
          && request.resource.data.email == authEmail()
          && selfSignupClinic(clinicId, authEmail())
          && entryAfterIs(authEmail(), clinicId, '1');
        allow update: if false;
        // The superadmin may clear any seat (deleting a whole clinic).
        allow delete: if superadmin();
        allow delete: if manager(clinicId)
          && canWrite(clinicId)
          && resource.data.email != getAfter(/databases/$(database)/documents/clinics/$(clinicId)).data.get('ownerEmail', '')
          && !entryAfterIs(resource.data.email, clinicId, seatId);
      }

      // Per-clinic branding: members read, the owner/superadmin write a validated doc.
      match /settings/{docId} {
        allow read: if member(clinicId);
        allow create, update: if manager(clinicId) && canWrite(clinicId)
          && ((docId == 'branding' && validBranding(request.resource.data))
              || (docId == 'schedule' && validSchedule(request.resource.data)));
        allow delete: if manager(clinicId) && canWrite(clinicId) && (docId == 'branding' || docId == 'schedule');
      }

      // Bookings: id is the slot start (epoch ms), so a slot holds one appointment.
      match /appointments/{apptId} {
        allow read: if member(clinicId);
        allow create: if member(clinicId) && canWrite(clinicId)
          && validAppt(request.resource.data)
          && apptId == string(request.resource.data.start)
          && request.resource.data.status == 'booked'
          && request.resource.data.createdBy == authEmail()
          && request.resource.data.end > request.time.toMillis();
        allow update: if member(clinicId) && canWrite(clinicId)
          && validAppt(request.resource.data)
          && request.resource.data.start == resource.data.start
          && request.resource.data.end == resource.data.end
          && request.resource.data.date == resource.data.date
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy;
        // Closing needs its history copy written in the same batch; the
        // superadmin may delete outright (deleting a whole clinic).
        allow delete: if superadmin();
        allow delete: if member(clinicId) && canWrite(clinicId)
          && existsAfter(/databases/$(database)/documents/clinics/$(clinicId)/appointmentHistory/$(apptId + '_' + string(resource.data.createdAt)));
      }
      // Create-only record of cancelled / no-show appointments.
      match /appointmentHistory/{id} {
        allow read: if member(clinicId);
        allow create: if member(clinicId) && canWrite(clinicId)
          && validClosed(request.resource.data)
          && id == string(request.resource.data.start) + '_' + string(request.resource.data.createdAt)
          && !existsAfter(/databases/$(database)/documents/clinics/$(clinicId)/appointments/$(string(request.resource.data.start)));
        allow update: if false;
        allow delete: if superadmin();
      }

      // Staff, leave and salary data is owner/superadmin only (not in memberSubs).
      match /staff/{id} {
        allow read: if manager(clinicId);
        allow write: if manager(clinicId) && canWrite(clinicId);
      }
      match /leaves/{id} {
        allow read: if manager(clinicId);
        allow write: if manager(clinicId) && canWrite(clinicId);
      }
      // One payment per staff member per month: the id is '<staffId>_<YYYY-MM>'.
      match /salaryPayments/{paymentId} {
        allow read: if manager(clinicId);
        allow delete: if manager(clinicId) && canWrite(clinicId);
        allow create, update: if manager(clinicId) && canWrite(clinicId)
          && request.resource.data.month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
          && paymentId == request.resource.data.staffId + '_' + request.resource.data.month
          && request.resource.data.needsReview is bool
          && request.resource.data.net is int
          && request.resource.data.paidOn is int
          && request.resource.data.adjustment is int;
      }

      // {sub}/{document=**} needs at least one segment, so this does not match
      // the clinic doc itself (a bare {document=**} also matches zero segments
      // and would let members rewrite or delete their own clinic doc).
      match /{sub}/{document=**} {
        allow read: if sub in memberSubs() && member(clinicId);
        allow write: if sub in memberSubs() && member(clinicId) && canWrite(clinicId);
      }
    }

    match /users/{uid} {
      allow read, write: if superadmin() || (allowed() && request.auth.uid == uid);
    }
  }
}
